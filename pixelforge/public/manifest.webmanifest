{
  "name": "Pixelforge - Design Studio",
  "short_name": "Pixelforge",
  "description": "Design logos, social posts, presentations and more. Free Canva alternative with AI features.",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#7c3aed",
  "background_color": "#0f0c29",
  "scope": "./",
  "start_url": "./",
  "categories": ["design", "graphics", "productivity", "photo"],
  "lang": "en",
  "shortcuts": [
    {
      "name": "New Design",
      "short_name": "New",
      "description": "Start a new blank design",
      "url": "./?action=new",
      "icons": [{ "src": "icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "My Projects",
      "short_name": "Projects",
      "description": "Open your saved projects",
      "url": "./?tab=projects",
      "icons": [{ "src": "icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Templates",
      "short_name": "Templates",
      "description": "Browse design templates",
      "url": "./?tab=templates",
      "icons": [{ "src": "icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ],
